{
  "name": "replygenie-extension",
  "version": "1.0.0",
  "private": true,
  "description": "Test suite for ReplyGenie extension logic (pure functions only — no Chrome APIs).",
  "scripts": {
    "test": "jest --runInBand",
    "test:eval": "jest src/tests/eval.test.js --verbose"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "setupFiles": [
      "./src/tests/setup.js"
    ]
  }
}
